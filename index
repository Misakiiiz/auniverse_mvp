<script>
(function(){
  // ---- navigation ----
  const links = document.querySelectorAll('.navlink');
  const pages = document.querySelectorAll('.page');
  function go(target){
    pages.forEach(p => p.classList.toggle('active', p.id === 'page-' + target));
    links.forEach(l => {
      const active = l.dataset.target === target;
      l.toggleAttribute('aria-current', active);
      if(active) l.setAttribute('aria-current','page'); else l.removeAttribute('aria-current');
    });
    window.scrollTo({top:0, behavior:'instant' in window ? 'instant' : 'auto'});
    closeSidebar();
  }
  links.forEach(l => l.addEventListener('click', () => go(l.dataset.target)));

  // ---- mobile sidebar ----
  const sidebar = document.getElementById('sidebar');
  const menuBtn = document.getElementById('menuBtn');
  const scrim = document.getElementById('scrim');
  function openSidebar(){ sidebar.classList.add('open'); scrim.classList.add('show'); menuBtn.setAttribute('aria-expanded','true'); }
  function closeSidebar(){ sidebar.classList.remove('open'); scrim.classList.remove('show'); menuBtn.setAttribute('aria-expanded','false'); }
  menuBtn.addEventListener('click', () => sidebar.classList.contains('open') ? closeSidebar() : openSidebar());
  scrim.addEventListener('click', closeSidebar);

  // ---- countdown to Dec 20 2026 ----
  const target = new Date('2026-12-20T00:00:00-03:00').getTime();
  function updateCountdown(){
    const now = Date.now();
    const diff = target - now;
    const dayEl = document.getElementById('countdownNum');
    const bigEl = document.getElementById('countdownBig');
    if(diff <= 0){
      dayEl.textContent = 'Lançado!';
      bigEl.textContent = 'Lançado!';
      return;
    }
    const days = Math.floor(diff / (1000*60*60*24));
    dayEl.textContent = days + ' dias';
    bigEl.textContent = days + ' dias';
  }
  updateCountdown();
  setInterval(updateCountdown, 1000*60*30);
}());
</script>
